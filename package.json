{
  "name": "boomtown",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Boomtown — a web implementation of the board game Acquire, mechanics only, re-themed.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @boomtown/desktop",
    "app:build": "npm run build --workspace @boomtown/desktop",
    "app:preview": "npm run start --workspace @boomtown/desktop",
    "build": "npm run typecheck",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/desktop/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:engine": "vitest run --project engine",
    "test:desktop": "vitest run --project desktop",
    "test:server": "vitest run --config packages/server/vitest.integration.config.ts",
    "smoke": "npm run smoke --workspace @boomtown/desktop",
    "server:dev": "npm run dev --workspace @boomtown/server",
    "server:deploy": "npm run deploy --workspace @boomtown/server",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "partykit": "^0.0.115",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true,
    "workerd@1.20240718.0": true
  }
}
