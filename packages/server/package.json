{
  "name": "@boomtown/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Boomtown online room: one Durable Object per game (KTD6), on Cloudflare's partyserver.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "npm run build --workspace @boomtown/phone && wrangler dev --port 1999",
    "deploy": "npm run build --workspace @boomtown/phone && wrangler deploy"
  },
  "dependencies": {
    "@boomtown/ai": "*",
    "@boomtown/client-core": "*",
    "@boomtown/engine": "*",
    "@boomtown/protocol": "*",
    "partyserver": "^0.5.10"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260927.1",
    "partysocket": "^1.3.0",
    "wrangler": "^4.142.0"
  }
}
