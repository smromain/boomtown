{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "types": ["node"],
    "paths": {
      "@boomtown/engine": ["packages/engine/src/index.ts"],
      "@boomtown/protocol": ["packages/protocol/src/index.ts"],
      "@boomtown/ai": ["packages/ai/src/index.ts"],
      "@boomtown/client-core": ["packages/client-core/src/index.ts"],
      "@boomtown/server": ["packages/server/src/index.ts"]
    }
  },
  // The Worker entry points need Cloudflare's runtime types; packages/server/tsconfig.json checks them.
  "exclude": ["packages/server/src/worker.ts", "packages/server/src/env.ts", "packages/server/src/room.ts", "packages/server/src/directory.ts"],
  "include": [
    "packages/*/src",
    "packages/*/test",
    "*.config.ts",
    "eslint.config.js"
  ]
}
